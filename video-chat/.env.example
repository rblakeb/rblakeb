# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git, so your keys never get committed.

# Claude API key from console.anthropic.com. Without it, AI companions use canned test replies.
ANTHROPIC_API_KEY=

# ---------- Voice agent (server-side voice, camera reactions, realistic avatar) ----------
# Needs a LiveKit server. For local testing:
#   docker run --rm --network host livekit/livekit-server:v1.13.11 --dev --bind 0.0.0.0
# which uses the dev key and secret below. In production use LiveKit Cloud's values.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# Run companion calls through the agent instead of the browser's speech:
# COMPANION_AGENT=1
# Where the agent can reach this website (to send transcripts back):
# AGENT_CALLBACK_BASE=http://localhost:3000

# Speech-to-text (deepgram.com). Without it and a voice provider, agent calls are text-only.
# DEEPGRAM_API_KEY=

# Character voices: Cartesia (cartesia.ai) or ElevenLabs (elevenlabs.io). Pick a voice ID
# for each character from the provider's voice library.
# CARTESIA_API_KEY=
# CARTESIA_VOICE_TUTOR=
# CARTESIA_VOICE_MUSIC=
# ELEVEN_API_KEY=
# ELEVENLABS_VOICE_TUTOR=
# ELEVENLABS_VOICE_MUSIC=

# Photorealistic avatar: tavus, simli, anam or bey, plus that provider's key and an
# avatar (face) ID per character. Without it, the browser draws an animated face.
# AVATAR_PROVIDER=
# AVATAR_ID_TUTOR=
# AVATAR_ID_MUSIC=
# TAVUS_API_KEY=
# TAVUS_PERSONA_ID=
# SIMLI_API_KEY=
# ANAM_API_KEY=
# BEY_API_KEY=
